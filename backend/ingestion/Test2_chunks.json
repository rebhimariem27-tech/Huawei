    "total_chunks": 13,
    "merged": true
  },
  {
    "chunk_id": "cbc7d499-931e-4e7d-a2b1-6213540769a8",
    "content": "Instruction de port : L'interface GigabitEthernet 0/0/2 doit être configurée en \nmode access dans le VLAN 10.",
    "chunk_type": "text",
    "page_number": 2,
    "source_file": "Test2.pdf",
    "chunk_index": 8,
    "section_title": "",
    "char_count": 109,
