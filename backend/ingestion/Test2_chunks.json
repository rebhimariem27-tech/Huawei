  },
  {
    "chunk_id": "fbf9f70c-c820-4677-8e37-93e57358b829",
    "content": "5. Sécurité et Accès\nLe protocole SSH (Stelnet) doit être activé sur tous les équipements.",
    "chunk_type": "text",
    "page_number": 2,
    "source_file": "Test2.pdf",
    "chunk_index": 11,
    "section_title": "",
    "char_count": 69,
    "original_type": "text",
