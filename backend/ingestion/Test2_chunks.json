  },
  {
    "chunk_id": "fe2d2807-494c-46b5-a9cd-da88dfb44211",
    "content": "4. Adressage IP et Routage\n• \nS1 (Vlanif 99) : 192.168.56.11/24\n• \nR1 (GE 0/0/0) : 192.168.56.10/24",
    "chunk_type": "text",
    "page_number": 2,
    "source_file": "Test2.pdf",
    "chunk_index": 9,
    "section_title": "",
    "char_count": 35,
    "original_type": "text",
