    "position_ratio": 0.905,
    "block_index": 8,
    "line_count": 1,
    "total_chunks": 13,
    "merged": true
  },
  {
    "chunk_id": "fd7053b3-83a0-4383-ab17-bff9978bd401",
    "content": "• \nTimeout : Le délai d'inactivité (idle-timeout) doit être fixé à 5 minutes.\n• \nUtilisateur : Un compte admin avec le niveau de privilège 15 est obligatoire.",
    "chunk_type": "text",
