  {
    "chunk_id": "063872ed-3ec5-46ac-b8eb-87546f4499fa",
    "content": "La topologie se compose d'un routeur de bordure (R1) et d'un switch de distribution (S1) \nreliés au Cloud de gestion.",
    "chunk_type": "text",
    "page_number": 1,
    "source_file": "Test2.pdf",
    "chunk_index": 2,
    "section_title": "",
