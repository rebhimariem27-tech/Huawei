    "total_chunks": 13,
    "merged": true
  },
  {
    "chunk_id": "716409dd-75af-40ab-a8b8-b1f0e1274e4f",
    "content": "• \nRoutage R1 : Une route statique doit exister vers le réseau de l'entreprise : \nip route-static 10.10.10.0 255.255.255.0 192.168.56.11",
    "chunk_type": "text",
    "page_number": 2,
